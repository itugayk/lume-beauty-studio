---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Figure from '../components/Figure.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import { SERVICES } from '../data/services';
---
<Layout title="Hizmetler" description="Lume Beauty Studio hizmetleri: saç, cilt bakımı, makyaj ve tırnak. Uzman ekip, premium ürünler.">
  <PageHeader
    crumb="Hizmetler"
    eyebrow="Hizmetlerimiz"
    title="Size özel <span class='accent-italic'>bakım</span> hizmetleri"
    intro="Dört ana başlıkta, her biri uzmanı tarafından uygulanan premium hizmetlerimizi keşfedin."
  />

  <!-- hızlı kategori menüsü -->
  <div class="sticky top-20 z-30 border-y border-blush/15 bg-cream/80 backdrop-blur">
    <div class="container-lux flex gap-2 overflow-x-auto py-3">
      {SERVICES.map((s) => (
        <a href={`#${s.slug}`} class="flex shrink-0 items-center gap-2 rounded-full border border-blush/20 px-4 py-2 text-sm text-mocha transition-all duration-300 hover:border-blush hover:bg-blush hover:text-white">
          <Icon name={s.icon} class="h-4 w-4" /> {s.name}
        </a>
      ))}
    </div>
  </div>

  <div class="space-y-24 py-24 lg:space-y-32 lg:py-32">
    {SERVICES.map((s, i) => (
      <section id={s.slug} class="container-lux scroll-mt-36">
        <div class={`grid items-center gap-12 lg:grid-cols-2 ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
          <div data-reveal>
            <Figure
              id={s.image}
              alt={s.name}
              w={820}
              h={760}
              class="aspect-[5/4] rounded-[2rem] shadow-[0_45px_90px_-55px_rgba(90,66,52,0.6)]"
              gradient={s.accent}
            />
          </div>

          <div>
            <span class="inline-flex items-center gap-3" data-reveal>
              <span class="grid h-12 w-12 place-items-center rounded-full bg-blush/15 text-blush-deep">
                <Icon name={s.icon} class="h-6 w-6" />
              </span>
              <span class="eyebrow">{s.tagline}</span>
            </span>
            <h2 class="display-2 mt-5" data-reveal>{s.name}</h2>
            <p class="mt-4 max-w-md text-mocha-soft" data-reveal>{s.description}</p>

            <ul class="mt-7 divide-y divide-blush/10 border-y border-blush/10">
              {s.items.map((it) => (
                <li class="flex items-start justify-between gap-4 py-3.5" data-reveal>
                  <div>
                    <p class="font-medium text-espresso">{it.name}</p>
                    <p class="text-sm text-mocha-soft">{it.desc}</p>
                  </div>
                  {it.duration && (
                    <span class="flex shrink-0 items-center gap-1.5 whitespace-nowrap pt-0.5 text-xs text-blush-deep">
                      <Icon name="clock" class="h-3.5 w-3.5" /> {it.duration}
                    </span>
                  )}
                </li>
              ))}
            </ul>

            <div class="mt-8 flex flex-wrap gap-3" data-reveal>
              <a href={`/randevu?hizmet=${s.slug}`} class="btn btn-primary">Randevu Al</a>
              <a href="/fiyatlar" class="btn btn-ghost">Fiyatları Gör</a>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <CTABand />
</Layout>
