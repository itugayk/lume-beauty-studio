---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Sayfa Bulunamadı">
  <section class="bg-grain relative grid min-h-[80vh] place-items-center overflow-hidden px-6 pt-24">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute left-1/4 top-1/3 h-72 w-72 rounded-full bg-blush-soft/40 blur-3xl"></div>
      <div class="absolute right-1/4 bottom-1/4 h-80 w-80 rounded-full bg-gold-soft/35 blur-3xl"></div>
    </div>
    <div class="text-center" data-reveal>
      <p class="font-serif text-[8rem] leading-none text-gradient">404</p>
      <h1 class="display-2 mt-2">Bu sayfayı <span class="accent-italic">bulamadık</span></h1>
      <p class="mx-auto mt-4 max-w-md text-mocha-soft">
        Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Sizi ışıltıya geri götürelim.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Ana Sayfaya Dön <Icon name="arrow" class="h-4 w-4" /></a>
        <a href="/randevu" class="btn btn-ghost">Randevu Al</a>
      </div>
    </div>
  </section>
</Layout>
