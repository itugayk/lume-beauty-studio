---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { TESTIMONIALS } from '../data/testimonials';

const mid = Math.ceil(TESTIMONIALS.length / 2);
const rowA = TESTIMONIALS.slice(0, mid);
const rowB = TESTIMONIALS.slice(mid);

const Stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < n);
---
<section class="relative overflow-hidden py-24 lg:py-32">
  <div class="container-lux">
    <SectionHeading
      eyebrow="Misafir Yorumları"
      title="Bizi <span class='accent-italic'>sevdiren</span> deneyimler"
      intro="Lume Beauty Studio’dan ayrılan misafirlerimizin ışıltısı, en güzel referansımız."
    />
  </div>

  <div class="marquee-paused mt-14 space-y-5">
    <!-- satır 1 -->
    <div class="flex w-max gap-5 animate-marquee" style="--marquee-duration:46s">
      {[...rowA, ...rowA].map((t) => (
        <figure class="w-[20rem] shrink-0 rounded-[1.5rem] border border-blush/15 bg-white/70 p-6 shadow-[0_24px_50px_-40px_rgba(90,66,52,0.5)] backdrop-blur">
          <div class="flex items-center gap-0.5 text-gold">
            {Stars(t.rating).map((on) => (
              <Icon name="star" class={on ? 'h-4 w-4' : 'h-4 w-4 opacity-25'} />
            ))}
          </div>
          <blockquote class="mt-3 text-sm leading-relaxed text-mocha">“{t.text}”</blockquote>
          <figcaption class="mt-4 flex items-center gap-3 border-t border-blush/10 pt-4">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-blush/15 font-serif text-sm text-blush-deep">
              {t.name.charAt(0)}
            </span>
            <span class="leading-tight">
              <span class="block text-sm font-medium text-espresso">{t.name}</span>
              <span class="block text-xs text-mocha-soft">{t.service}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- satır 2 (ters yön) -->
    <div class="flex w-max gap-5 animate-marquee" style="--marquee-duration:54s; animation-direction:reverse">
      {[...rowB, ...rowB].map((t) => (
        <figure class="w-[20rem] shrink-0 rounded-[1.5rem] border border-blush/15 bg-white/70 p-6 shadow-[0_24px_50px_-40px_rgba(90,66,52,0.5)] backdrop-blur">
          <div class="flex items-center gap-0.5 text-gold">
            {Stars(t.rating).map((on) => (
              <Icon name="star" class={on ? 'h-4 w-4' : 'h-4 w-4 opacity-25'} />
            ))}
          </div>
          <blockquote class="mt-3 text-sm leading-relaxed text-mocha">“{t.text}”</blockquote>
          <figcaption class="mt-4 flex items-center gap-3 border-t border-blush/10 pt-4">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-blush/15 font-serif text-sm text-blush-deep">
              {t.name.charAt(0)}
            </span>
            <span class="leading-tight">
              <span class="block text-sm font-medium text-espresso">{t.name}</span>
              <span class="block text-xs text-mocha-soft">{t.service}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <!-- kenar yumuşatma -->
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-cream to-transparent"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-cream to-transparent"></div>
</section>
