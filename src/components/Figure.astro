---
import { ph } from '../lib/images';

interface Props {
  id: string;
  alt: string;
  w?: number;
  h?: number;
  class?: string;
  imgClass?: string;
  gradient?: string;
  eager?: boolean;
  sizes?: string;
}
const {
  id,
  alt,
  w = 1000,
  h,
  class: cls = '',
  imgClass = '',
  gradient = 'linear-gradient(135deg,#f6e9e3,#c9a0a0)',
  eager = false,
  sizes,
} = Astro.props;

const src = ph(id, w, h);
const src2x = ph(id, Math.round(w * 1.7), h ? Math.round(h * 1.7) : undefined);
---
<div class={`relative overflow-hidden ${cls}`} style={`background:${gradient}`}>
  <img
    src={src}
    srcset={`${src} 1x, ${src2x} 2x`}
    sizes={sizes}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class={`h-full w-full object-cover transition-opacity duration-700 ${imgClass}`}
    onload="this.style.opacity='1'"
    onerror="this.style.opacity='0'"
    style="opacity:0"
  />
</div>
