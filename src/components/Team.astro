---
import Icon from './Icon.astro';
import Figure from './Figure.astro';
import SectionHeading from './SectionHeading.astro';
import type { Member } from '../data/team';

interface Props {
  members: Member[];
  eyebrow?: string;
  title?: string;
  intro?: string;
  showCta?: boolean;
  cols?: string;
}
const {
  members,
  eyebrow = 'Ekibimiz',
  title = "Tutkulu eller, <span class='accent-italic'>uzman</span> dokunuşlar",
  intro = 'Her biri alanında deneyimli sanatçılardan oluşan ekibimiz, sizi en iyi versiyonunuzla buluşturmak için burada.',
  showCta = true,
  cols = 'sm:grid-cols-2 lg:grid-cols-4',
} = Astro.props;
---
<section id="ekip" class="bg-grain relative bg-cream-soft py-24 lg:py-32">
  <div class="container-lux">
    <div class="flex flex-col items-end justify-between gap-6 md:flex-row md:items-end">
      <SectionHeading align="left" eyebrow={eyebrow} title={title} intro={intro} />
      {showCta && (
        <a href="/ekip" class="btn btn-ghost shrink-0" data-reveal>
          Ekibi Tanı <Icon name="arrowUpRight" class="h-4 w-4" />
        </a>
      )}
    </div>

    <div class={`mt-14 grid gap-5 ${cols}`}>
      {members.map((m) => (
        <article class="team-card group relative overflow-hidden rounded-[1.75rem]" data-reveal>
          <Figure
            id={m.image}
            alt={m.name}
            w={520}
            h={640}
            class="aspect-[4/5]"
            imgClass="transition-transform duration-[1.1s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-espresso/90 via-espresso/20 to-transparent"></div>

          <div class="absolute inset-x-0 bottom-0 p-5">
            <p class="text-[0.7rem] uppercase tracking-[0.2em] text-blush-soft">{m.role}</p>
            <h3 class="font-serif text-xl text-cream">{m.name}</h3>

            <div class="team-reveal">
              <p class="pt-2 text-sm leading-relaxed text-cream/80">{m.bio}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {m.tags.map((t) => (
                  <span class="rounded-full border border-white/25 px-2.5 py-1 text-[0.65rem] tracking-wide text-cream/85">{t}</span>
                ))}
              </div>
              {m.instagram && (
                <a
                  href={m.instagram}
                  class="pointer-events-auto mt-3 inline-flex items-center gap-1.5 text-xs text-blush-soft transition-colors hover:text-cream"
                  aria-label={`${m.name} Instagram`}
                >
                  <Icon name="instagram" class="h-4 w-4" /> Takip et
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.6s var(--ease-lux), opacity 0.45s ease;
  }
  .team-reveal > * { overflow: hidden; }
  .team-card:hover .team-reveal {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  @media (hover: none) {
    .team-reveal { grid-template-rows: 1fr; opacity: 1; }
  }
</style>
