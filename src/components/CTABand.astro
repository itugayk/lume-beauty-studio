---
import Icon from './Icon.astro';
import Figure from './Figure.astro';
import { IMG } from '../lib/images';
import { SITE, waLink } from '../data/site';
---
<section class="container-lux py-8">
  <div class="bg-grain relative overflow-hidden rounded-[2.5rem]">
    <Figure
      id={IMG.salonInterior}
      alt="Lume Beauty Studio iç mekânı"
      w={1600}
      h={760}
      class="absolute inset-0 h-full w-full"
      gradient="linear-gradient(135deg,#5a4234,#33241b)"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-espresso/90 via-espresso/70 to-mocha/40"></div>

    <div class="relative grid gap-8 px-7 py-16 md:grid-cols-[1.4fr_1fr] md:items-center md:px-14 lg:py-20">
      <div>
        <span class="eyebrow text-blush-soft" data-reveal>Randevu</span>
        <h2 class="display-2 mt-4 max-w-xl text-cream" data-reveal>
          Kendinize ayıracağınız <span class="accent-italic text-blush-soft">zamanı</span> hemen planlayın
        </h2>
        <p class="mt-4 max-w-md text-cream/70" data-reveal>
          Online formla birkaç adımda randevunuzu oluşturun ya da WhatsApp üzerinden hızlıca bize yazın.
        </p>
      </div>

      <div class="flex flex-col gap-3 md:items-end" data-reveal>
        <a href="/randevu" class="btn btn-blush w-full justify-center md:w-auto">
          <Icon name="calendar" class="h-4 w-4" /> Online Randevu Al
        </a>
        <a
          href={waLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn w-full justify-center border border-white/30 !text-cream hover:!bg-white hover:!text-espresso md:w-auto"
        >
          <Icon name="whatsapp" class="h-4 w-4" /> WhatsApp'tan Yaz
        </a>
        <a href={`tel:${SITE.phone}`} class="mt-1 flex items-center gap-2 text-sm text-cream/60 transition-colors hover:text-cream md:justify-end">
          <Icon name="phone" class="h-4 w-4" /> {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
